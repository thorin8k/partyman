# Configuración de servidor
HOST=0.0.0.0
PORT=8400
DATABASE_PATH=./data/partyman.sqlite3
UPLOADS_PATH=./uploads
BACKUP_DIR=./backups
BACKUP_KEEP=20
PUBLIC_ORIGIN=http://localhost:8400

# Credenciales de administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2b\$10\$hMYewHVcL.KF/Z2nFLixie714T64cCHWke2FDoEuczU.OBempGq6i

# Acceso a la party (opcional: vacío = libre, con valor = pide contraseña al entrar)
JOIN_PASSWORD=

# Minutos hasta auto-confirmar un resultado de torneo sin respuesta del rival
REPORT_TIMEOUT_MIN=5

# Steam (opcional)
STEAM_API_KEY=
STEAM_ENABLED=true

# SteamGridDB (opcional, para buscar carátulas de juegos)
STEAMGRIDDB_API_KEY=

# WiFi (opcional: muestra QR en el display junto al QR de unión)
WIFI_SSID=
WIFI_PASSWORD=

# Seguridad (LAN HTTP: dejar en false; solo true con HTTPS, si no el navegador dropea la sesión)
COOKIE_SECURE=false
